  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: a9cc2190064622e4883d63a917f543a0, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::InteractuarObjetos
  NombreObjeto: conductor
  AccionObjeto: Hablar con
  TXTDialogoNormal:
  - TituloPersonaje: Marta
    TXTLinea: "Buenas noches, disculpe, \xBFEste cami\xF3n a d\xF3nde lleva?"
  - TituloPersonaje: Conductor
    TXTLinea: "Buenas noches jovencita, nos dirigimos a la estaci\xF3n de San Lorenzo."
  - TituloPersonaje: Conductor
    TXTLinea: "Solo estamos haciendo una \xFAltima parada aqu\xED antes de continuar."
  - TituloPersonaje: Marta
    TXTLinea: "Perfecto, \xBFcree que pueda abordar?"
  - TituloPersonaje: Conductor
    TXTLinea: No. A menos que tenga la tarifa de entrada.
  - TituloPersonaje: Marta
    TXTLinea: Oh, bueno, muchas gracias.
  - TituloPersonaje: Marta
    TXTLinea: <i>Tengo que encontrar la forma de abordar antes de que se me escape</i>
  EsObjetoTutorial: 0
  ClaveEvento: {fileID: 11400000, guid: 8bf295baa2f221746b0de76e805026b7, type: 2}
  DatosPuntoInflexion: {fileID: 11400000, guid: c4ddef0c3e9c32944a4e64450c4f8077, type: 2}
  TXTDialogoConClave:
  - TituloPersonaje: Conductor
    TXTLinea: Llegas justo a tiempo, estamos a punto de salir.
  NPCAnimator: {fileID: 7654075636563078210}
  ParametroHablar: Hablando
  GiraHaciaPlayer: 1
  CamInteracion: {fileID: 0}
