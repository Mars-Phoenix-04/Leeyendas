    MostrarDialogo: 1
    LineasDialogoPaso:
    - TituloPersonaje: Radio
      TXTLinea: "\xA1Visite el sal\xF3n Mal\xEDbu! El lugar donde la noche cobra
        vida y la diversi\xF3n comienza."
    - TituloPersonaje: Marta
      TXTLinea: "Ash, solo les ped\xED permiso para ir a un sal\xF3n de baile y se
