  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::InteractuarObjetos
  NombreObjeto: ventana
  AccionObjeto: Ver
  TXTDialogoNormal:
  - TituloPersonaje: Marta
    TXTLinea: "El sol ya se est\xE1 ocultando. Si no salgo de aqu\xED pronto, no
      voy a poder ir al Malibu."
  - TituloPersonaje: Marta
    TXTLinea: Tiene que haber una forma de escapar.
  EsObjetoTutorial: 0
  ClaveEvento: {fileID: 11400000, guid: 9dc5501e1caca96489b43de28bcb5e03, type: 2}
  DatosPuntoInflexion: {fileID: 11400000, guid: 07ae6c5a720f4394ca1a6ccc296b2998, type: 2}
  TXTDialogoConClave:
  - TituloPersonaje: Marta
    TXTLinea: "Entre m\xE1s me tarde en salir, menos tiempo podr\xE9 disfrutar en
      el Malibu."
  - TituloPersonaje: Marta
    TXTLinea: "Mmmm\u2026"
  - TituloPersonaje: Marta
    TXTLinea: 'Tal vez sea descabellado, pero tengo idea. '
