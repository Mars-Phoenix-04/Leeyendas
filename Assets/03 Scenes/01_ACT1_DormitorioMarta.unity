  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 8333f0b08bcd1b54288d15b276611c1e, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::InteractuarClaveObtencion
  ClaveDt: {fileID: 11400000, guid: b8be695f0f0b08143bf76156607e8b3a, type: 2}
  TXTPrimeraInteraccion:
  - "Oh Teddy, t\xFA eres el \xFAnico que me entiende. Sabes que yo solo me quiero
    salir a divertir. No puedo estar atrapada en esta casa el resto de mi vida."
  - "A\xFAn recuerdo el d\xEDa que llegaste a mi vida. Mi pap\xE1 lleg\xF3 contigo
    en sus brazos y desde entonces nos volvimos inseparables. "
  - "T\xFA debes tener alguna idea de c\xF3mo salir de aqu\xED, \xBFno es as\xED?"
  TXTClaveRecogida:
  - "Muchas gracias Teddy, te prometo que volver\xE9 antes de que cant\xE9 el gallo."
  NombreObjeto: Teddy
  AccionObjeto: Hablar con
