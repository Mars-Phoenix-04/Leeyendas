  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::InteractuarObjetos
  NombreObjeto: armario
  AccionObjeto: Revisar
  TXTDialogoNormal:
  - TituloPersonaje: Marta
    TXTLinea: "Tengo tanta ropa y aun as\xED no es la suficiente. Lo bueno es que
      encontr\xE9 este lindo conjunto para ir a bailar."
  - TituloPersonaje: Marta
    TXTLinea: "Este vestido me lo regalaron mis padres durante mi quincea\xF1era
      y desde entonces lo he usado en cada fiesta a la que he asistido."
  - TituloPersonaje: Marta
    TXTLinea: "Claro que mis pap\xE1s no saben de todas las veces que me llegu\xE9
      a escapar para ir a ellas."
  EsObjetoTutorial: 0
  ClaveEvento: {fileID: 0}
  DatosPuntoInflexion: {fileID: 0}
