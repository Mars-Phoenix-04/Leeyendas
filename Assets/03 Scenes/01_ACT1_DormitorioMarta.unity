--- !u!114 &8682350350421125781
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 8202652538083287610}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: a9cc2190064622e4883d63a917f543a0, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::InteractuarObjetos
  NombreObjeto: librero
  AccionObjeto: Revisar
  TXTDialogoNormal:
  - TituloPersonaje: Marta
    TXTLinea: "Libros, rompecabezas, juegos de mesa. A veces no s\xE9 por qu\xE9
      guardo tanta cosa en este librero."
  - TituloPersonaje: Marta
    TXTLinea: Muchos de estos libros los tengo guardados desde la primaria y solo
      han estado acumulando polvo.
  - TituloPersonaje: Marta
    TXTLinea: "Mi mam\xE1 siempre dijo que los libros son la puerta al conocimiento
      y que me llevar\xEDan muy lejos."
  - TituloPersonaje: Marta
    TXTLinea: "Bueno, esperemos que uno de estos me lleve al Malib\xFA."
  ClaveEvento: {fileID: 0}
  DatosPuntoInflexion: {fileID: 0}
  TXTDialogoConClave: []
  NPCAnimator: {fileID: 0}
  ParametroHablar: 
  GiraHaciaPlayer: 0
  CamInteracion: {fileID: 0}
