  NombreObjeto: puerta
  AccionObjeto: Revisar
  TXTDialogoNormal:
  - TituloPersonaje: Marta
    TXTLinea: "No creo que mis pap\xE1s hayan dejado la puerta abierta despu\xE9s
      de la tremenda rega\xF1ada que me pusieron."
  - TituloPersonaje: Marta
    TXTLinea: "Debe haber otra forma de salir de aqu\xED, pero \xBFc\xF3mo?"
  ClaveEvento: {fileID: 11400000, guid: b8be695f0f0b08143bf76156607e8b3a, type: 2}
  DatosPuntoInflexion: {fileID: 11400000, guid: 30bcf1eeb23840848bf9eb438129458a, type: 2}
  TXTDialogoConClave:
  - TituloPersonaje: Marta
    TXTLinea: "Mmmmmm\u2026"
  - TituloPersonaje: Marta
    TXTLinea: 'Estoy comenzando a pensar que tal vez no cerraron la puerta. '
  - TituloPersonaje: Marta
    TXTLinea: Aunque no pierdo nada con intentarlo.
  NPCAnimator: {fileID: 0}
