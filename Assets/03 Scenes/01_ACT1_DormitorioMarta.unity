  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::InteractuarObjetos
  NombreObjeto: radio
  AccionObjeto: 'Escuchar '
  TXTDialogoNormal:
  - TituloPersonaje: Radio
    TXTLinea: "\xA1M\xFAsica, baile y sue\xF1os! Venga al sal\xF3n de baile m\xE1s
      popular de toda la ciudad."
  - TituloPersonaje: Radio
    TXTLinea: 'Baile hasta que su cuerpo no aguante, abrimos en cuanto salga el sol. '
  - TituloPersonaje: Marta
    TXTLinea: "Ash, no puede ser. Si no salgo de aqu\xED pronto, me voy a arrepentir
      de ello toda mi vida."
  - TituloPersonaje: Marta
    TXTLinea: Dice que abren en las noches, eso me da tiempo para buscar una forma
      de salir.
  ClaveEvento: {fileID: 0}
  DatosPuntoInflexion: {fileID: 0}
  TXTDialogoConClave: []
  NPCAnimator: {fileID: 0}
