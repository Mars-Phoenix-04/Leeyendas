  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: a9cc2190064622e4883d63a917f543a0, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::InteractuarObjetos
  NombreObjeto: mascara
  AccionObjeto: Ver
  TXTDialogoNormal:
  - TituloPersonaje: Marta
    TXTLinea: "Qu\xE9 extra\xF1a mascara. \xBFQui\xE9n traer\xEDa esto a un sal\xF3n
      de baile?"
  - TituloPersonaje: Marta
    TXTLinea: Es curioso, siento como si me estuviera viendo fijamente a los ojos.
  - TituloPersonaje: Marta
    TXTLinea: Como si me advirtiera de algo.
  - TituloPersonaje: Marta
    TXTLinea: "Ya llegu\xE9 tan lejos como para estarme arrepintiendo hasta ahorita
      \xBFverdad?"
  - TituloPersonaje: Mascara
    TXTLinea: ...
  - TituloPersonaje: Marta
    TXTLinea: "\xBFQu\xE9 estoy haciendo? Deber\xEDa estar bailando en vez de perder
      el tiempo con una mascara tan fea."
  EsObjetoTutorial: 0
  ClaveEvento: {fileID: 0}
  DatosPuntoInflexion: {fileID: 0}
  TXTDialogoConClave: []
  NPCAnimator: {fileID: 0}
  ParametroHablar: 
  GiraHaciaPlayer: 0
  CamInteracion: {fileID: 8862966847260930124}
