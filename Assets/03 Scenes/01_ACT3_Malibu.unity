    - target: {fileID: 3051884654093226660, guid: 3018fb1a2459efb4bbf161d3f81d899a, type: 3}
      propertyPath: PasosCinematicas.Array.data[2].LineasDialogoPaso.Array.data[0].TXTLinea
      value: 
      objectReference: {fileID: 0}
    - target: {fileID: 3051884654093226660, guid: 3018fb1a2459efb4bbf161d3f81d899a, type: 3}
      propertyPath: PasosCinematicas.Array.data[3].LineasDialogoPaso.Array.data[0].TXTLinea
      value: "Eso estuvo cerca, por poco y perd\xEDa mi boleto de entrada al Malibu."
      objectReference: {fileID: 0}
    - target: {fileID: 3051884654093226660, guid: 3018fb1a2459efb4bbf161d3f81d899a, type: 3}
      propertyPath: PasosCinematicas.Array.data[3].LineasDialogoPaso.Array.data[1].TXTLinea
      value: No puedo creer que tuve que caer tan bajo como fingir ser pareja de
        ese tipo.
      objectReference: {fileID: 0}
    - target: {fileID: 3051884654093226660, guid: 3018fb1a2459efb4bbf161d3f81d899a, type: 3}
      propertyPath: PasosCinematicas.Array.data[3].LineasDialogoPaso.Array.data[2].TXTLinea
      value: "Aunque me parece extra\xF1o que no haya dicho nada y solo me siguiera
        la corriente."
      objectReference: {fileID: 0}
    - target: {fileID: 3051884654093226660, guid: 3018fb1a2459efb4bbf161d3f81d899a, type: 3}
      propertyPath: PasosCinematicas.Array.data[3].LineasDialogoPaso.Array.data[3].TXTLinea
      value: "\xBFA d\xF3nde se habr\xE1 ido?"
      objectReference: {fileID: 0}
    - target: {fileID: 3051884654093226660, guid: 3018fb1a2459efb4bbf161d3f81d899a, type: 3}
      propertyPath: PasosCinematicas.Array.data[4].LineasDialogoPaso.Array.data[0].TXTLinea
      value: 
      objectReference: {fileID: 0}
    - target: {fileID: 3051884654093226660, guid: 3018fb1a2459efb4bbf161d3f81d899a, type: 3}
      propertyPath: PasosCinematicas.Array.data[4].LineasDialogoPaso.Array.data[1].TXTLinea
      value: No puedo creer que tuve que caer tan bajo como fingir ser pareja de
        ese tipo.
      objectReference: {fileID: 0}
    - target: {fileID: 3051884654093226660, guid: 3018fb1a2459efb4bbf161d3f81d899a, type: 3}
      propertyPath: PasosCinematicas.Array.data[4].LineasDialogoPaso.Array.data[2].TXTLinea
      value: "Aunque me parece extra\xF1o que no haya dicho nada y solo me siguiera
        la corriente."
      objectReference: {fileID: 0}
    - target: {fileID: 3051884654093226660, guid: 3018fb1a2459efb4bbf161d3f81d899a, type: 3}
      propertyPath: PasosCinematicas.Array.data[4].LineasDialogoPaso.Array.data[3].TXTLinea
      value: "\xBFA d\xF3nde se habr\xE1 ido?"
      objectReference: {fileID: 0}
    - target: {fileID: 3051884654093226660, guid: 3018fb1a2459efb4bbf161d3f81d899a, type: 3}
      propertyPath: PasosCinematicas.Array.data[6].LineasDialogoPaso.Array.data[0].TXTLinea
      value: "Hola, disculpa, sobre lo de ahorita\u2026"
      objectReference: {fileID: 0}
    - target: {fileID: 3051884654093226660, guid: 3018fb1a2459efb4bbf161d3f81d899a, type: 3}
      propertyPath: PasosCinematicas.Array.data[6].LineasDialogoPaso.Array.data[1].TXTLinea
      value: "\xBFQu\xE9 cosa? \xBFSobre c\xF3mo fingiste ser mi novia y tomaste
        ventaja de mi reservaci\xF3n para entrar aqu\xED sin pagar?"
      objectReference: {fileID: 0}
    - target: {fileID: 3051884654093226660, guid: 3018fb1a2459efb4bbf161d3f81d899a, type: 3}
      propertyPath: PasosCinematicas.Array.data[6].LineasDialogoPaso.Array.data[2].TXTLinea
      value: ...
      objectReference: {fileID: 0}
    - target: {fileID: 3051884654093226660, guid: 3018fb1a2459efb4bbf161d3f81d899a, type: 3}
      propertyPath: PasosCinematicas.Array.data[6].LineasDialogoPaso.Array.data[3].TXTLinea
      value: "Bueno, si lo pones as\xED suena muy mal."
      objectReference: {fileID: 0}
    - target: {fileID: 3051884654093226660, guid: 3018fb1a2459efb4bbf161d3f81d899a, type: 3}
      propertyPath: PasosCinematicas.Array.data[6].LineasDialogoPaso.Array.data[4].TXTLinea
      value: "No te preocupes, al menos el dinero que gast\xE9 sirvi\xF3 de algo."
      objectReference: {fileID: 0}
    - target: {fileID: 3051884654093226660, guid: 3018fb1a2459efb4bbf161d3f81d899a, type: 3}
      propertyPath: PasosCinematicas.Array.data[6].LineasDialogoPaso.Array.data[5].TXTLinea
      value: "\xBFPuedo saber el nombre de esta hermosa damisela en apuros?"
      objectReference: {fileID: 0}
    - target: {fileID: 3051884654093226660, guid: 3018fb1a2459efb4bbf161d3f81d899a, type: 3}
      propertyPath: PasosCinematicas.Array.data[6].LineasDialogoPaso.Array.data[6].TXTLinea
      value: No tienes que ser tan formal, recuerda que somos novios jajaja
      objectReference: {fileID: 0}
    - target: {fileID: 3051884654093226660, guid: 3018fb1a2459efb4bbf161d3f81d899a, type: 3}
      propertyPath: PasosCinematicas.Array.data[6].LineasDialogoPaso.Array.data[7].TXTLinea
      value: Me llamo Marta.
      objectReference: {fileID: 0}
    - target: {fileID: 3051884654093226660, guid: 3018fb1a2459efb4bbf161d3f81d899a, type: 3}
      propertyPath: PasosCinematicas.Array.data[6].LineasDialogoPaso.Array.data[8].TXTLinea
      value: Un gusto conocerte Marta.
      objectReference: {fileID: 0}
    - target: {fileID: 3051884654093226660, guid: 3018fb1a2459efb4bbf161d3f81d899a, type: 3}
      propertyPath: PasosCinematicas.Array.data[6].LineasDialogoPaso.Array.data[9].TXTLinea
      value: Mi nombre es Juan.
      objectReference: {fileID: 0}
    - target: {fileID: 3051884654093226660, guid: 3018fb1a2459efb4bbf161d3f81d899a, type: 3}
      propertyPath: PasosCinematicas.Array.data[7].LineasDialogoPaso.Array.data[0].TXTLinea
      value: "Hola, disculpa, sobre lo de ahorita\u2026"
      objectReference: {fileID: 0}
