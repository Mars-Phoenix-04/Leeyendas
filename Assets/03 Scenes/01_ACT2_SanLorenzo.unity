  m_Script: {fileID: 11500000, guid: a9cc2190064622e4883d63a917f543a0, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::InteractuarObjetos
  NombreObjeto: guardia
  AccionObjeto: 'Hablar con '
  TXTDialogoNormal:
  - TituloPersonaje: Guardia
    TXTLinea: "Lo siento joven, pero est\xE1 haciendo m\xE1s larga la fila y hoy
      es noche de parejas. Le pido que se vaya a cola o tendr\xE9 que correrlo de
      aqu\xED."
  - TituloPersonaje: ???
    TXTLinea: "Deme un momento m\xE1s, estoy seguro de que ya est\xE1 a punto de
      llegar. Dijo que nos \xEDbamos a ver aqu\xED."
  - TituloPersonaje: Marta
    TXTLinea: "<i>Mmm, tal vez pueda tomar ventaja de esta situaci\xF3n</i>"
  EsObjetoTutorial: 0
  ClaveEvento: {fileID: 11400000, guid: f6ca679716e8372438d90d89dbe61cda, type: 2}
  DatosPuntoInflexion: {fileID: 11400000, guid: 9cf68c14cafe2054e8b6a2ac72f1e04a, type: 2}
  TXTDialogoConClave:
  - TituloPersonaje: Guardia
    TXTLinea: "Ya pas\xF3 mucho tiempo joven, lo voy a tener que llevar al final
      de la fila."
  - TituloPersonaje: ???
    TXTLinea: "Espere, solo deme un minuto m\xE1s, por favor."
  - TituloPersonaje: Guardia
    TXTLinea: "Si no se mueve ahora mismo voy a\u2026"
  NPCAnimator: {fileID: 633836427}
  ParametroHablar: Hablando
  GiraHaciaPlayer: 1
  CamInteracion: {fileID: 332436557}
