  m_Script: {fileID: 11500000, guid: a9cc2190064622e4883d63a917f543a0, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::InteractuarObjetos
  NombreObjeto: letrero
  AccionObjeto: Ver
  TXTDialogoNormal:
  - TituloPersonaje: Marta
    TXTLinea: "No puedo creer que por fin est\xE9 aqu\xED."
  - TituloPersonaje: Marta
    TXTLinea: "El Malibu, el sal\xF3n de baile m\xE1s popular de toda la ciudad y
      donde la noche cobra vida."
  - TituloPersonaje: Marta
    TXTLinea: "Y pensar que casi no vengo porque el \u201CDiablo\u201D anda asechando
      en las noches. "
  - TituloPersonaje: Marta
    TXTLinea: "Esas son puras mentiras que las mam\xE1s dicen para que no salgamos
      tan tarde."
  - TituloPersonaje: Marta
    TXTLinea: "En fin, parece que hoy es noche de baile tropical as\xED que voy a
      disfrutar esta noche como si estuviera en Canc\xFAn."
  EsObjetoTutorial: 0
  ClaveEvento: {fileID: 0}
