  m_GameObject: {fileID: 4961512360604145939}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 8333f0b08bcd1b54288d15b276611c1e, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::InteractuarClaveObtencion
  ClaveDt: {fileID: 11400000, guid: 8bf295baa2f221746b0de76e805026b7, type: 2}
  TXTPrimeraInteraccion:
  - "Un bote de basura com\xFAn y corriente. Normalmente no me reducir\xEDa a buscar
    algo dentro de ellos, pero creo que no tengo opci\xF3n."
  - Ewww
  - "\xA1Qu\xE9 asco! "
  - "\xBFQu\xE9 es esto?"
  TXTClaveRecogida:
  - "No vuelvo a meter mis manos ah\xED, fue horrible."
  NombreObjeto: bote de basura
  AccionObjeto: Revisar
