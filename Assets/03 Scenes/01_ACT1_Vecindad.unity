    - target: {fileID: 3051884654093226660, guid: 3018fb1a2459efb4bbf161d3f81d899a, type: 3}
      propertyPath: PasosCinematicas.Array.data[3].VelocidadMovimientoPersonaje
      value: 0
      objectReference: {fileID: 0}
    - target: {fileID: 3051884654093226660, guid: 3018fb1a2459efb4bbf161d3f81d899a, type: 3}
      propertyPath: PasosCinematicas.Array.data[4].LineasDialogoPaso.Array.size
      value: 1
      objectReference: {fileID: 0}
    - target: {fileID: 3051884654093226660, guid: 3018fb1a2459efb4bbf161d3f81d899a, type: 3}
      propertyPath: PasosCinematicas.Array.data[5].LineasDialogoPaso.Array.size
      value: 0
      objectReference: {fileID: 0}
    - target: {fileID: 3051884654093226660, guid: 3018fb1a2459efb4bbf161d3f81d899a, type: 3}
      propertyPath: PasosCinematicas.Array.data[1].LineasDialogoPaso.Array.data[0].TXTLinea
      value: "\xA1No puedo creerlo!"
      objectReference: {fileID: 0}
    - target: {fileID: 3051884654093226660, guid: 3018fb1a2459efb4bbf161d3f81d899a, type: 3}
      propertyPath: PasosCinematicas.Array.data[1].LineasDialogoPaso.Array.data[1].TXTLinea
      value: 'No entiendo a que le tienen miedo mis padres. '
      objectReference: {fileID: 0}
    - target: {fileID: 3051884654093226660, guid: 3018fb1a2459efb4bbf161d3f81d899a, type: 3}
      propertyPath: PasosCinematicas.Array.data[1].LineasDialogoPaso.Array.data[2].TXTLinea
      value: "Solo quiero salir a divertirme y ya est\xE1."
      objectReference: {fileID: 0}
    - target: {fileID: 3051884654093226660, guid: 3018fb1a2459efb4bbf161d3f81d899a, type: 3}
      propertyPath: PasosCinematicas.Array.data[2].LineasDialogoPaso.Array.data[0].TXTLinea
      value: "Por fin! Dulce cielo, ya sal\xED de ah\xED."
      objectReference: {fileID: 0}
    - target: {fileID: 3051884654093226660, guid: 3018fb1a2459efb4bbf161d3f81d899a, type: 3}
      propertyPath: PasosCinematicas.Array.data[2].LineasDialogoPaso.Array.data[1].TXTLinea
      value: "Afortunadamente, mis padres ni estaban en casa. Y yo aqu\xED batallando."
      objectReference: {fileID: 0}
    - target: {fileID: 3051884654093226660, guid: 3018fb1a2459efb4bbf161d3f81d899a, type: 3}
      propertyPath: PasosCinematicas.Array.data[2].LineasDialogoPaso.Array.data[2].TXTLinea
      value: "Ahora viene lo m\xE1s dif\xEDcil\u2026"
      objectReference: {fileID: 0}
    - target: {fileID: 3051884654093226660, guid: 3018fb1a2459efb4bbf161d3f81d899a, type: 3}
      propertyPath: PasosCinematicas.Array.data[2].LineasDialogoPaso.Array.data[3].TXTLinea
      value: "\xBF\xA1C\xD3MO ME VOY A IR AL MALIBU DESDE AQU\xCD!?"
      objectReference: {fileID: 0}
    - target: {fileID: 3051884654093226660, guid: 3018fb1a2459efb4bbf161d3f81d899a, type: 3}
      propertyPath: PasosCinematicas.Array.data[3].LineasDialogoPaso.Array.data[0].TXTLinea
