  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::InteractuarObjetos
  NombreObjeto: cartel
  AccionObjeto: Ver
  TXTDialogoNormal:
  - TituloPersonaje: Marta
    TXTLinea: "\u201CCuco S\xE1nchez y su Mariachi Debut\u201D"
  - TituloPersonaje: Marta
    TXTLinea: "\u201CSal\xF3n teatral Malibu en la curva de San Lorenzo\u201D"
  - TituloPersonaje: Marta
    TXTLinea: "Parece ser que el Malibu tambi\xE9n maneja este tipo de eventos."
  - TituloPersonaje: Marta
    TXTLinea: "Aunque yo prefiero escuchar m\xFAsica de verdad en la radio, no estar\xEDa
      mal darse la vuelta."
  - TituloPersonaje: Marta
    TXTLinea: "De momento, tengo que enfocarme en c\xF3mo llegar al Malibu hoy."
  EsObjetoTutorial: 0
  ClaveEvento: {fileID: 0}
  DatosPuntoInflexion: {fileID: 0}
