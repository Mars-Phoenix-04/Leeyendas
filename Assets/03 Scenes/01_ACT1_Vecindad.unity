  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: a9cc2190064622e4883d63a917f543a0, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::InteractuarObjetos
  NombreObjeto: carteles
  AccionObjeto: Ver
  TXTDialogoNormal:
  - TituloPersonaje: Marta
    TXTLinea: "Ni cuenta de que pon\xEDan tantos carteles detr\xE1s de mi casa."
  - TituloPersonaje: Marta
    TXTLinea: Parece que las corridas de toros se han vuelto algo muy popular.
  - TituloPersonaje: Marta
    TXTLinea: "Tambi\xE9n hay de varios salones de bailes."
  - TituloPersonaje: Marta
    TXTLinea: "\xA1Mira! Hasta hay uno del Malib\xFA."
  - TituloPersonaje: Marta
    TXTLinea: "\u201C\xA1Noche de parejas! Disfrut\xE9 de nuestras mejores bebidas
      y canciones en compa\xF1\xEDa de su media naranja.\u201D"
  - TituloPersonaje: Marta
    TXTLinea: "\u201CEntrada exclusiva a parejas\u201D"
  - TituloPersonaje: Marta
    TXTLinea: ...
  - TituloPersonaje: Marta
    TXTLinea: Bueno, esperemos que eso no aplique hoy.
  ClaveEvento: {fileID: 0}
  DatosPuntoInflexion: {fileID: 0}
  TXTDialogoConClave: []
  NPCAnimator: {fileID: 0}
  ParametroHablar: 
  GiraHaciaPlayer: 0
  CamInteracion: {fileID: 0}
