  m_Script: {fileID: 11500000, guid: a9cc2190064622e4883d63a917f543a0, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::InteractuarObjetos
  NombreObjeto: con chica
  AccionObjeto: Hablar
  TXTDialogoNormal:
  - TituloPersonaje: Chica
    TXTLinea: "Disculpe las molestias, pero \xBFde casualidad no ha visto unas monedas
      por aqu\xED?"
  - TituloPersonaje: Marta
    TXTLinea: "Mmm\u2026no, no he visto ningunas monedas. \xBFD\xF3nde fue la \xFAltima
      vez que las tra\xEDa?"
  - TituloPersonaje: Chica
    TXTLinea: "Estaba pasando el rato con mi novio en el terreno bald\xEDo, ya sabes,
      platicando."
  - TituloPersonaje: Marta
    TXTLinea: "Ewwww, \xBFen ese basurero?"
  - TituloPersonaje: Chica
    TXTLinea: "Cuando me acord\xE9 de que mi mam\xE1 me encarg\xF3 comprar pan blanco
      y ahora no tengo nada de dinero."
  - TituloPersonaje: Marta
    TXTLinea: Oh no, que lastima, espero lo encuentres pronto.
  - TituloPersonaje: Marta
    TXTLinea: <i>Lo siento amiga, pero quien se lo encuentra se lo queda</i>.
  EsObjetoTutorial: 0
  ClaveEvento: {fileID: 0}
  DatosPuntoInflexion: {fileID: 0}
  TXTDialogoConClave: []
  NPCAnimator: {fileID: 1256953437}
  ParametroHablar: Hablando
  GiraHaciaPlayer: 1
  CamInteracion: {fileID: 459983079}
