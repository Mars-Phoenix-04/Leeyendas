  m_Script: {fileID: 11500000, guid: a9cc2190064622e4883d63a917f543a0, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::InteractuarObjetos
  NombreObjeto: "tel\xE9fono"
  AccionObjeto: Revisar
  TXTDialogoNormal:
  - TituloPersonaje: Marta
    TXTLinea: "Qu\xE9 raro, parece que dejaron la cabina abierta."
  - TituloPersonaje: Marta
    TXTLinea: "Podr\xEDa intentar marcarle a mis amigas de la preparatoria para ver
      si alguien me puede dar un avent\xF3n."
  - TituloPersonaje: Marta
    TXTLinea: "Aunque, no creo que sean de mucha ayuda\u2026"
  - TituloPersonaje: Marta
    TXTLinea: Mejor busco otra forma de ir al Malibu.
  EsObjetoTutorial: 0
  ClaveEvento: {fileID: 0}
  DatosPuntoInflexion: {fileID: 0}
